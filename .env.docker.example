# Copy this file to .env before running Docker Compose.
POSTGRES_PASSWORD=change-this-local-password

# Optional model provider. The app works in local generation mode without it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Optional Supabase production mode. Leave empty to use the Compose database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false
DAILY_RESEARCH_LIMIT=20
WORKSPACE_STORAGE_LIMIT_MB=250

# Optional OpenAlex identity and key.
OPENALEX_MAILTO=
OPENALEX_API_KEY=
