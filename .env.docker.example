# Copy this file to .env before running Docker Compose.
POSTGRES_PASSWORD=change-this-local-password
AUTH_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# local stores files in the Docker volume. Use s3 for COS/OSS/MinIO.
OBJECT_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional model provider. The app works in local generation mode without it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
AI_ACCESS_MODE=hybrid
AI_KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters

DAILY_RESEARCH_LIMIT=20
DAILY_BYOK_RESEARCH_LIMIT=100
DAILY_LOCAL_RESEARCH_LIMIT=50
WORKSPACE_STORAGE_LIMIT_MB=250

# Optional OpenAlex identity and key.
OPENALEX_MAILTO=
OPENALEX_API_KEY=
