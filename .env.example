# Optional. Without a model key, the app uses a deterministic local generator.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
AI_ACCESS_MODE=hybrid
AI_KEY_ENCRYPTION_SECRET=

# Hosted multi-user mode. Both values are required.
DATABASE_URL=
AUTH_SECRET=
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
PUBLIC_APP_URL=http://localhost:3000

# Optional SMTP. When configured, users can reset forgotten passwords.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Durable files: local persistent volume or an S3-compatible provider.
OBJECT_STORAGE_DRIVER=local
DATA_DIRECTORY=./data
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Per-user and per-workspace safety limits.
DAILY_RESEARCH_LIMIT=20
DAILY_BYOK_RESEARCH_LIMIT=100
DAILY_LOCAL_RESEARCH_LIMIT=50
WORKSPACE_STORAGE_LIMIT_MB=250

# Optional OpenAlex polite-pool identity and API key.
OPENALEX_MAILTO=
OPENALEX_API_KEY=
