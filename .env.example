# Optional. Without a model key, the app uses a deterministic local generator.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Production cloud platform. Set all four values to enable authentication,
# private workspaces, durable files, research history, and pgvector retrieval.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false

# Per-user and per-workspace safety limits.
DAILY_RESEARCH_LIMIT=20
WORKSPACE_STORAGE_LIMIT_MB=250

# Optional OpenAlex polite-pool identity and API key.
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Optional PostgreSQL + pgvector connection for host-based development.
# DATABASE_URL=postgresql://user:password@localhost:5432/database
